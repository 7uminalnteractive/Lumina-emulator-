<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: sidebar com leve profundidade (gradiente vertical sutil)
     em vez da cor chapada anterior, mais a borda direita que a separa do
     conteúdo principal sem precisar de sombra. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#151D09"
                android:endColor="#101606" />
        </shape>
    </item>
    <item android:width="1dp" android:gravity="right">
        <shape android:shape="rectangle">
            <solid android:color="@color/lumina_border" />
        </shape>
    </item>
</layer-list>
