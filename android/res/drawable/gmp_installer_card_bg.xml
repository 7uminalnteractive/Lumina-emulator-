<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: fundo do card da tela de Instalador, no estilo "card com
     brilho" das referências de upload que o usuário mandou (cantos
     arredondados grandes, leve brilho verde vazando por cima, borda sutil).
     Antes era só o container transparente do activity_installer.xml, sem
     nenhum card por trás. A ordem importa: o brilho (gmp_glow_blob, com
     margens negativas pra vazar) fica atrás do corpo do card, que é opaco. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/gmp_glow_blob"
        android:top="-90dp"
        android:left="40dp"
        android:right="40dp"
        android:height="220dp" />
    <item
        android:top="36dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lumina_bg2" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/lumina_border" />
        </shape>
    </item>
</layer-list>
