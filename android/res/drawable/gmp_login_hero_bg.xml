<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#2E4013"
                android:centerColor="#1E2A0E"
                android:endColor="#141C09" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:startColor="#3D9AE637"
                android:endColor="#009AE637" />
            <size android:width="640dp" android:height="640dp" />
        </shape>
        <inset
            android:insetLeft="-260dp"
            android:insetTop="-320dp" />
    </item>
</layer-list>
