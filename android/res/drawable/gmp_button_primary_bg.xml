<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: botão mais arredondado (quase pill-shape) e com leve
     gradiente, para bater com os botões grandes e chamativos das
     referências -- antes era um retângulo de cantos discretos (12dp), sem
     nenhuma profundidade. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#ABEF4A"
        android:endColor="@color/lumina_blue" />
</shape>
