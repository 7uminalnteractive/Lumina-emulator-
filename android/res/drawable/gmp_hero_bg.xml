<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: hero banner com três camadas -- gradiente diagonal de
     base, um "glow" radial sutil no canto (para dar profundidade sem
     precisar de imagem), e o fade inferior que já existia para legibilidade
     do texto por cima. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#3D5A1E"
                android:centerColor="#24300F"
                android:endColor="#161F0A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.82"
                android:centerY="0.18"
                android:startColor="#4C9AE637"
                android:endColor="#009AE637" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#E6141C08" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#1F9AE637" />
        </shape>
    </item>
</layer-list>
