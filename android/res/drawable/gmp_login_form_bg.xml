<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: painel do formulário de login como um card elevado,
     com cantos arredondados só no topo (para "flutuar" sobre o hero,
     com margem negativa no layout) e leve borda, dando a separação de
     camada que a referência tem entre o hero e o formulário. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lumina_bg2" />
    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp"
        android:bottomLeftRadius="8dp"
        android:bottomRightRadius="8dp" />
    <stroke android:width="1dp" android:color="@color/lumina_border" />
</shape>
