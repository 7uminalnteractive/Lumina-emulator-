<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: família "Neue Montreal" (fontes fornecidas pelo usuário,
     convertidas de .woff para .otf, já que o Android não lê .woff direto).
     Uso: android:fontFamily="@font/neue_montreal" em qualquer TextView/tema;
     o sistema escolhe o arquivo certo sozinho conforme textStyle/fontWeight. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/neue_montreal_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/neue_montreal_light"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/neue_montreal_light_italic"
        android:fontStyle="italic"
        android:fontWeight="300"
        app:font="@font/neue_montreal_light_italic"
        app:fontStyle="italic"
        app:fontWeight="300" />
    <font
        android:font="@font/neue_montreal_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/neue_montreal_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/neue_montreal_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/neue_montreal_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
    <font
        android:font="@font/neue_montreal_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/neue_montreal_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/neue_montreal_medium_italic"
        android:fontStyle="italic"
        android:fontWeight="500"
        app:font="@font/neue_montreal_medium_italic"
        app:fontStyle="italic"
        app:fontWeight="500" />
    <font
        android:font="@font/neue_montreal_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/neue_montreal_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/neue_montreal_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/neue_montreal_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />
</font-family>
