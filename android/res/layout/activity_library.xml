<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Sidebar -->
        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:background="@drawable/gmp_sidebar_bg"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="22dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="26dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/tab_games"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/gmp_nav_item_selected"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="@color/lumina_on_accent"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Jogos"
                    android:textColor="@color/lumina_on_accent"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_store"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▤"
                    android:textColor="@color/lumina_muted"
                    android:textSize="19sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textColor="@color/lumina_muted"
                    android:textSize="19sp" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tab_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <TextView
                        android:id="@+id/profile_avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/gmp_avatar_bg"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/lumina_on_accent"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/profile_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/lumina_online_dot" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Main content -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/hero_banner"
                    android:layout_width="match_parent"
                    android:layout_height="192dp"
                    android:layout_margin="20dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/gmp_hero_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/hero_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gmp_badge_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Sua biblioteca"
                            android:textColor="@color/lumina_blue"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:textColor="@android:color/white"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/hero_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/hero_play_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/gmp_button_primary_bg"
                            android:paddingHorizontal="22dp"
                            android:paddingVertical="10dp"
                            android:text="▶  Jogar"
                            android:textColor="@color/lumina_on_accent"
                            android:textStyle="bold"
                            android:textSize="12.5sp" />

                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Todos os jogos"
                        android:textColor="@color/lumina_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/folder_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lumina_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/games_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="12dp"
                    android:clipToPadding="false"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick_folder_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precisamos de acesso ao armazenamento"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscamos automaticamente seus jogos em Armazenamento/GMP/Jogo/Game. Toque abaixo e permita &quot;Acesso a todos os arquivos&quot; nas configurações do Android."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_pick_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conceder acesso ao armazenamento"
            android:textAllCaps="false"
            android:background="@drawable/gmp_button_primary_bg"
            android:textColor="@color/lumina_on_accent"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhum jogo encontrado em Armazenamento/GMP/Jogo/Game"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coloque seus arquivos .iso/.cso/.pbp dentro dessa pasta no armazenamento do aparelho."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/library_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
