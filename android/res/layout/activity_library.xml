<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Sidebar -->
        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@drawable/gmp_sidebar_bg"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:id="@+id/tab_games"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/gmp_nav_item_selected"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jogos"
                    android:textColor="@color/lumina_text"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_store"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loja"
                    android:textColor="@color/lumina_muted"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_media"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧩"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patches"
                    android:textColor="@color/lumina_muted"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/lumina_text"
                android:textSize="17sp"
                android:background="@drawable/gmp_button_ghost_bg"
                android:layout_marginBottom="14dp" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/gmp_avatar_bg"
                    android:gravity="center"
                    android:text="G"
                    android:textColor="@color/lumina_on_accent"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/lumina_online_dot" />

            </FrameLayout>

        </LinearLayout>

        <!-- Main content -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/hero_banner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_margin="20dp"
                    android:background="@drawable/gmp_hero_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/hero_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gmp_badge_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="SUA BIBLIOTECA"
                            android:textColor="@color/lumina_blue"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:textColor="@android:color/white"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/hero_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/hero_play_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/gmp_button_primary_bg"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="9dp"
                            android:text="▶  JOGAR"
                            android:textColor="@color/lumina_on_accent"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Continue jogando"
                        android:textColor="@color/lumina_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/folder_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lumina_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/games_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="14dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick_folder_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precisamos de acesso ao armazenamento"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscamos automaticamente seus jogos em Armazenamento/GMP/Jogo/Game. Toque abaixo e permita &quot;Acesso a todos os arquivos&quot; nas configurações do Android."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_pick_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conceder acesso ao armazenamento"
            android:textAllCaps="false"
            android:background="@drawable/gmp_button_primary_bg"
            android:textColor="@color/lumina_on_accent"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhum jogo encontrado em Armazenamento/GMP/Jogo/Game"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coloque seus arquivos .iso/.cso/.pbp dentro dessa pasta no armazenamento do aparelho."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/library_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
