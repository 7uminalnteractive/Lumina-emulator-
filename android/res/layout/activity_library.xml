<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tab_games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jogos"
                android:textColor="@color/lumina_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Patches"
                android:textColor="@color/lumina_muted"
                android:textSize="17sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/lumina_text"
                android:textSize="18sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/lumina_button_bg"
                    android:gravity="center"
                    android:text="L"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/lumina_online_dot" />

            </FrameLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/hero_banner"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/lumina_hero_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/lumina_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="SUA BIBLIOTECA"
                    android:textColor="@color/lumina_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:textColor="@android:color/white"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hero_play_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/lumina_button_bg"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="10dp"
                    android:text="▶  JOGAR"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:text="Continue jogando"
            android:textColor="@color/lumina_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/folder_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/lumina_muted"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/games_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pick_folder_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precisamos de acesso ao armazenamento"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscamos automaticamente seus jogos em Armazenamento/PSP/GAME. Toque abaixo e permita &quot;Acesso a todos os arquivos&quot; nas configurações do Android."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_pick_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conceder acesso ao armazenamento"
            android:textAllCaps="false"
            android:background="@drawable/lumina_button_bg"
            android:textColor="@android:color/white"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nenhum jogo encontrado em Armazenamento/PSP/GAME"
            android:textColor="@color/lumina_text"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coloque seus arquivos .iso/.cso/.pbp dentro dessa pasta no armazenamento do aparelho."
            android:textColor="@color/lumina_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/library_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
