<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_item_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="22dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/profile_avatar_circle"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:background="@drawable/gmp_avatar_bg"
        android:gravity="center"
        android:textColor="@color/lumina_on_accent"
        android:textStyle="bold"
        android:textSize="36sp"
        android:elevation="4dp" />

    <TextView
        android:id="@+id/profile_name_label"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/lumina_text"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
