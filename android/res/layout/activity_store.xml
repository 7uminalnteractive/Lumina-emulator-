<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/store_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sidebar"
            android:layout_width="wrap_content"
            android:minWidth="76dp"
            android:layout_height="match_parent"
            android:background="@drawable/gmp_sidebar_bg"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="22dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="26dp" />

            <LinearLayout
                android:id="@+id/tab_games"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="@color/lumina_muted"
                    android:textSize="19sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_store"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/gmp_nav_item_selected"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▤"
                    android:textColor="@color/lumina_on_accent"
                    android:textSize="19sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textColor="@color/lumina_muted"
                    android:textSize="19sp" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tab_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <TextView
                        android:id="@+id/profile_avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/gmp_avatar_bg"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="@color/lumina_on_accent"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/profile_status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/lumina_online_dot" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/main_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_margin="20dp"
                    android:background="@drawable/gmp_hero_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/gmp_badge_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="LOJA GMPES"
                            android:textColor="@color/lumina_blue"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-condensed"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:textColor="@android:color/white"
                            android:text="Patches para PES 2014" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12.5sp"
                            android:text="Baixe competições atualizadas direto no app." />

                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:text="Disponíveis para baixar"
                    android:textColor="@color/lumina_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/store_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="14dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>
