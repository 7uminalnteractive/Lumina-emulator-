<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.46"
        android:background="@drawable/gmp_login_hero_bg"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="44dp"
            android:paddingVertical="32dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/gmp_logo_card_bg"
                android:layout_marginBottom="24dp"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@drawable/gmp_symbol" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GMP GAMEPORT"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="30sp"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Seus jogos de PSP, sempre atualizados e prontos para jogar."
                android:textColor="#D9FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:maxWidth="280dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="36dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="180+"
                        android:textColor="@color/lumina_blue"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-condensed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patches"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PSP"
                        android:textColor="@color/lumina_blue"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-condensed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="e PPSSPP"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.54"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="52dp"
            android:paddingVertical="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gmp_badge_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="CONTA"
                android:textColor="@color/lumina_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bem-vindo de volta"
                android:textColor="@color/lumina_text"
                android:textSize="30sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:text="Entre na sua conta para acessar sua biblioteca."
                android:textColor="@color/lumina_muted"
                android:textSize="14.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail"
                android:textColor="@color/lumina_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/email_field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="seuemail@gmail.com"
                android:inputType="textEmailAddress"
                android:textColor="@color/lumina_text"
                android:textColorHint="@color/lumina_muted"
                android:background="@drawable/gmp_input_bg"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Senha"
                    android:textColor="@color/lumina_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/forgot_password_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esqueceu a senha?"
                    android:textColor="@color/lumina_blue"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <EditText
                android:id="@+id/password_field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:textColor="@color/lumina_text"
                android:textColorHint="@color/lumina_muted"
                android:background="@drawable/gmp_input_bg"
                android:textSize="15sp"
                android:layout_marginBottom="18dp" />

            <CheckBox
                android:id="@+id/stay_logged_in_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permanecer conectado"
                android:textColor="@color/lumina_muted"
                android:textSize="13.5sp"
                android:checked="true"
                android:layout_marginBottom="22dp" />

            <TextView
                android:id="@+id/login_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lumina_error"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <ProgressBar
                android:id="@+id/login_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15.5sp"
                android:textColor="@color/lumina_on_accent"
                android:background="@drawable/gmp_button_primary_bg"
                android:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
