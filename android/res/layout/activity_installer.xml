<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: tela do Instalador. Aberta pela Biblioteca ao tocar em "Baixar".
     Redesenhada como um "card com brilho" (ver gmp_installer_card_bg.xml),
     no estilo das referências de upload que o usuário mandou: chip de
     ícone no topo, barra de progresso em pílula e selo de porcentagem, em
     vez do bloco de texto + barra fina que havia antes. Todos os IDs
     continuam os mesmos, então InstallerActivity.java não precisa mudar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/installer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/gmp_installer_card_bg"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="64dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/gmp_icon_chip_bg"
            android:padding="14dp"
            android:src="@drawable/ic_nav_download"
            android:tint="@color/lumina_blue"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/installer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/lumina_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/installer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/lumina_muted"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/installer_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:max="1000"
            android:progressDrawable="@drawable/gmp_installer_progress"
            android:indeterminateTint="@color/lumina_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/installer_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gmp_percent_chip_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/lumina_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/installer_bytes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lumina_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/installer_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/gmp_button_primary_bg"
            android:textAllCaps="false"
            android:textColor="@color/lumina_on_accent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/installer_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/gmp_button_ghost_bg"
            android:text="Fechar"
            android:textAllCaps="false"
            android:textColor="@color/lumina_text"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
