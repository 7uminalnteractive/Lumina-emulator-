<?xml version="1.0" encoding="utf-8"?>
<!-- GMP Gameport: tela do Instalador. Aberta pela Biblioteca ao tocar em "Baixar". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/installer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/installer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/lumina_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/installer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/lumina_muted"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/installer_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:max="1000"
            android:progressTint="@color/lumina_blue"
            android:indeterminateTint="@color/lumina_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/installer_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/lumina_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/installer_bytes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lumina_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/installer_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/gmp_button_primary_bg"
            android:textAllCaps="false"
            android:textColor="@color/lumina_on_accent"
            android:textStyle="bold" />

        <Button
            android:id="@+id/installer_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/gmp_button_ghost_bg"
            android:text="Fechar"
            android:textAllCaps="false"
            android:textColor="@color/lumina_text"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
